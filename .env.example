# Copy this file to ~/.copilot/hooks/ledger/.env and fill in your key.
# The installer does this for you; this file is for manual setups.

# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Any OpenRouter model that supports JSON mode.
LEDGER_MODEL=deepseek/deepseek-v4-flash

# Optional. Input caps, in characters. Run `inspect.sh caps` to see whether
# these fit your own history before changing them.
# LEDGER_MAX_PROMPT_CHARS=16000
# LEDGER_MAX_RESPONSE_CHARS=12000

# Optional. Set to 0 to disable the trace log.
# LEDGER_TRACE=1

# Optional. Set to 1 to force the Stop hook to block (for testing).
# LEDGER_FORCE_BLOCK=0
