# Copy this file to ~/.copilot/hooks/ledger/.env and fill in your key.
# The installer does this for you; this file is for manual setups.

# --- Provider -------------------------------------------------------------
# openrouter | openai | groq | deepseek | together | fireworks | ollama | custom
LEDGER_PROVIDER=openrouter

# Model id, in the chosen provider's own naming.
# OpenRouter ids are namespaced ("vendor/model"); other providers use bare ids.
LEDGER_MODEL=deepseek/deepseek-v4.1-flash

# Key for the chosen provider. Use "none" for a local endpoint that needs no auth.
LEDGER_API_KEY=sk-or-v1-...

# Only for LEDGER_PROVIDER=custom: the full chat-completions URL.
# LEDGER_BASE_URL=https://my-gateway.internal/v1/chat/completions

# --- Input caps -----------------------------------------------------------
# Run `inspect.sh caps` to see whether these fit your own history.
# LEDGER_MAX_PROMPT_CHARS=16000
# LEDGER_MAX_RESPONSE_CHARS=12000

# --- Cost reporting -------------------------------------------------------
# USD per 1M tokens. Override if your provider charges differently.
# LEDGER_PRICE_IN=0.07
# LEDGER_PRICE_OUT=0.28

# --- Debugging ------------------------------------------------------------
# Set to 0 to disable the trace log.
# LEDGER_TRACE=1

# Set to 1 to force the Stop hook to block (for testing).
# LEDGER_FORCE_BLOCK=0

# --- Install paths (read by install.sh, not by the hooks) -----------------
# Override where the installer puts things. A leading ~ is expanded.
# TASKGUARD_HOOKS_DIR=~/.copilot/hooks/ledger
# TASKGUARD_CONFIG=~/.copilot/hooks/ledger.json
# TASKGUARD_INSTRUCTIONS_DIR=~/.copilot/instructions
